{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run complete learning demo",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-u", "run_demo.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Start interactive prediction API",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-u", "serve_demo.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    }
  ]
}
